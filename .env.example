# =============================================================================
# PRISM — variabili d'ambiente (copia in .env e compila i valori reali)
# =============================================================================

# Ambiente Node: development = locale | production = deploy
NODE_ENV=development

# Profilo Redis: auto (consigliato) | local | production
# auto → development usa Docker, production usa Upstash
PRISM_ENV=auto

# --- Redis: sviluppo (Docker) ---
# docker run -d --name prism-redis -p 6379:6379 redis:7-alpine
REDIS_URL_LOCAL=redis://127.0.0.1:6379

# --- Redis: produzione (Upstash o altro) ---
REDIS_URL_PRODUCTION=rediss://default:PASSWORD@HOST.upstash.io:6379

# Override opzionale: se impostato, ignora LOCAL/PRODUCTION
# REDIS_URL=

# --- API esterne ---
GEMINI_API_KEY=
TAVILY_API_KEY=

# --- Firebase (percorsi opzionali; default come firebaseAdmin.js) ---
# FIREBASE_CREDENTIALS_PATH=./firebase-credentials_dev.json

# --- Worker / test ---
# USE_MOCK_GENERATOR=true
# SIMULATE_FAULT=F1
