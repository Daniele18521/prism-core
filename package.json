{
  "name": "prism-core",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start:api": "nodemon src/api/index.js",
    "start:worker": "node src/worker/processor.js",
    "redis:up": "docker compose up -d redis",
    "redis:down": "docker compose down",
    "test:redis": "node -e \"import('./src/utils/resolveRedisUrl.js').then(m=>console.log(m.resolveRedisUrl()))\"",
    "test": "node --test tests/*.test.js",
    "test:services": "node --test tests/shaper.test.js tests/search.test.js tests/refiner.test.js tests/contentIngest.test.js",
    "test:pipeline": "node scripts/run-pipeline.mjs --mock --topic=Test pipeline PRISM mock 2026",
    "test:errors": "node scripts/test-error-handling.mjs",
    "test:errors:integration": "node scripts/test-error-handling.mjs --integration --mock",
    "test:errors:simulate": "node scripts/test-error-handling.mjs --simulate --mock --phase=F2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Daniele18521/prism-core.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Daniele18521/prism-core/issues"
  },
  "homepage": "https://github.com/Daniele18521/prism-core#readme",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@tavily/core": "^0.7.3",
    "bullmq": "^5.76.8",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "^13.10.0",
    "ioredis": "^5.10.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
